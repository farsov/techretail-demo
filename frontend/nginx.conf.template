# La imagen de nginx sustituye ${BACKEND_URL} al arrancar (solo las variables definidas en el entorno).
server {
    listen 8080;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Rutas de Angular: todo lo que no es un archivo se resuelve en index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
